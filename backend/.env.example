# ==============================================================================
# SpecialTech AI ERP — Конфигурация FastAPI + PostgreSQL 17
# Скопируйте в backend/.env и заполните реальными значениями на сервере/ПК
# ==============================================================================

APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000

# Подключение к вашему локальному или корпоративному PostgreSQL 17:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/specialtech_erp"

# Секретный ключ подписи JWT (на продакшене задайте длинную случайную строку)
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Разрешённые Origins фронтенда (JSON-массив)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Секреты внешних интеграций (хранятся только на сервере)
GEMINI_API_KEY=""
GLONASS_API_TOKEN=""
ONEC_API_SECRET=""

# Локальная директория загрузки фото/документов
UPLOAD_DIR="./uploads"
